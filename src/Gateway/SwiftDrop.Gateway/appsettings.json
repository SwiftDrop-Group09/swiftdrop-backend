{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5000",
        "Protocols": "Http1"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/v1/auth/{**remainder}"
        }
      },
      "identity-users": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/v1/users/{**remainder}"
        }
      },
      "identity-audit-logs": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/v1/audit-logs/{**remainder}"
        }
      },
      "delivery-quotes": {
        "ClusterId": "delivery",
        "Match": {
          "Path": "/api/v1/quotes/{**remainder}"
        }
      },
      "delivery-parcels": {
        "ClusterId": "delivery",
        "Match": {
          "Path": "/api/v1/parcels/{**remainder}"
        }
      },
      "delivery-deliveries": {
        "ClusterId": "delivery",
        "Match": {
          "Path": "/api/v1/deliveries/{**remainder}"
        }
      },
      "delivery-couriers": {
        "ClusterId": "delivery",
        "Match": {
          "Path": "/api/v1/couriers/{**remainder}"
        }
      },
      "delivery-zones": {
        "ClusterId": "delivery",
        "Match": {
          "Path": "/api/v1/zones/{**remainder}"
        }
      },
      "delivery-pricing-tiers": {
        "ClusterId": "delivery",
        "Match": {
          "Path": "/api/v1/pricing-tiers/{**remainder}"
        }
      },
      "merchant-merchants": {
        "ClusterId": "merchant",
        "Match": {
          "Path": "/api/v1/merchants/{**remainder}"
        }
      },
      "merchant-merchant-orders": {
        "ClusterId": "merchant",
        "Match": {
          "Path": "/api/v1/merchant/orders/{**remainder}"
        }
      },
      "merchant-merchant-webhooks": {
        "ClusterId": "merchant",
        "Match": {
          "Path": "/api/v1/merchant/webhooks/{**remainder}"
        }
      },
      "identity-jwks": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/.well-known/jwks.json"
        }
      },
      "delivery-reports": {
        "ClusterId": "delivery",
        "Match": {
          "Path": "/api/v1/reports/deliveries"
        }
      },
      "delivery-graphql": {
        "ClusterId": "delivery",
        "Match": {
          "Path": "/graphql"
        }
      }
    },
    "Clusters": {
      "identity": {
        "HttpRequest": {
          "AllowResponseBuffering": false
        },
        "Destinations": {
          "primary": {
            "Address": "http://identity-service:8080/"
          }
        }
      },
      "delivery": {
        "HttpRequest": {
          "AllowResponseBuffering": false
        },
        "Destinations": {
          "primary": {
            "Address": "http://delivery-service:8080/"
          }
        }
      },
      "merchant": {
        "HttpRequest": {
          "AllowResponseBuffering": false
        },
        "Destinations": {
          "primary": {
            "Address": "http://merchant-service:8080/"
          }
        }
      }
    }
  }
}
