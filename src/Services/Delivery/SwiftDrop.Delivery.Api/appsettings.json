{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Operations": {
    "TimeZone": "Asia/Colombo"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://127.0.0.1:8081",
        "Protocols": "Http2"
      }
    }
  }
}
