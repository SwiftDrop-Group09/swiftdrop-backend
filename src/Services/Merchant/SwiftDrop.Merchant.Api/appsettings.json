{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Merchant": {
    "Orders": {
      "Processing": {
        "StatusRefreshAfter": "00:00:05",
        "StatusRefreshPollingInterval": "00:00:02"
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:8080",
        "Protocols": "Http1"
      }
    }
  }
}
